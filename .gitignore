*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# CocoaPods (not used, but ignore if introduced later)
Pods/

# Firebase — the committed GoogleService-Info.plist is a PLACEHOLDER only.
# Once you drop in your real one from the Firebase console, DO NOT commit
# it under a different filename — this ignore rule only protects you if
# you rename the placeholder aside; the tracked file at
# Nodi/Resources/GoogleService-Info.plist is intentionally kept in git as
# a placeholder so the project structure builds out of the box.
GoogleService-Info.local.plist

# Cloud Functions
functions/node_modules/
functions/lib/
functions/.env
*.env

