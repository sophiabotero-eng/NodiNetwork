rules_version = '2';

// Nodi Firestore security rules.
//
// Built up incrementally alongside the client, phase by phase. Each
// section below is labeled with the phase that introduced it so it's
// clear why a given rule exists. Fields that should only ever be written
// by trusted server code (Cloud Functions, which use the Admin SDK and
// therefore bypass these rules entirely) are explicitly locked out of
// client writes — see the `isUnchanged`/`lockedFields` helpers.

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

// True if none of `fields` changed between the existing doc and the
// incoming write. Used to protect server-computed counters/flags from
// being edited directly by a client.
function unchanged(fields) {
  return fields.toSet().difference(
    fields.toSet().intersection(request.resource.data.diff(resource.data).affectedKeys())
  ) == fields.toSet();
}

match /databases/{database}/documents {

  // ---- Phase 1: Auth + Profile Foundation ----

  match /users/{uid} {
    // Profiles are public — Nodi is a portfolio/networking product and
    // profiles double as public portfolio pages (Phase 5), so anyone
    // (including signed-out web visitors) can read them.
    allow read: if true;

    // A user can only ever create/update their own document, and can
    // never touch the counters or verification flag — those are written
    // exclusively by Cloud Functions in response to real events (a follow,
    // a connection, a project being published, manual verification).
    // `profileViewCount` is the one exception: like a project's
    // `viewCount`, any signed-in user may bump it (viewing someone's
    // profile shouldn't require write access to the rest of their
    // document) but never change anything else while doing so.
    allow create: if isOwner(uid)
      && request.resource.data.id == uid
      && request.resource.data.followerCount == 0
      && request.resource.data.followingCount == 0
      && request.resource.data.connectionCount == 0
      && request.resource.data.projectCount == 0
      && request.resource.data.profileViewCount == 0
      && request.resource.data.isVerified == false;

    allow update: if (isOwner(uid) && unchanged(['followerCount', 'followingCount', 'connectionCount', 'projectCount', 'profileViewCount', 'isVerified']))
      || (isSignedIn() && !isOwner(uid) && unchanged([
           'username', 'displayName', 'email', 'bio', 'profession', 'location', 'website',
           'instagramHandle', 'linkedInHandle', 'behanceHandle', 'school', 'currentCompany',
           'profilePhotoURL', 'coverImageURL', 'softwareUsed', 'availability', 'isVerified',
           'accountType', 'followerCount', 'followingCount', 'connectionCount', 'projectCount',
           'authProviders', 'onboardingComplete', 'fcmTokens', 'createdAt', 'updatedAt',
           'lastActiveAt', 'geohash', 'latitude', 'longitude', 'searchKeywords'
         ]));

    // No client-side deletes. Account deletion is handled by a Cloud
    // Function triggered on Firebase Auth user deletion so we can also
    // clean up subcollections, storage objects, and reserved usernames.
    allow delete: if false;
  }

  // Username reservations. Doc ID is the lowercased username; `uid` field
  // must match the reserving user. The uniqueness guarantee comes from
  // the client running this inside a transaction (see
  // UserRepository.reserveUsername) combined with these rules preventing
  // anyone from overwriting someone else's reservation.
  match /usernames/{username} {
    allow read: if isSignedIn();
    allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    allow update: if false;
  }

  match /users/{uid}/notifications/{notificationId} {
    // Only the owner can read their own notifications. Only Cloud
    // Functions write new ones; the client is only allowed to flip
    // `isRead`.
    allow read: if isOwner(uid);
    allow update: if isOwner(uid) && unchanged([
      'kind', 'actorId', 'actorDisplayName', 'actorPhotoURL', 'message', 'deepLinkURL', 'createdAt'
    ]);
    allow create, delete: if false;
  }

  // Written exclusively by the recomputeRecommendations Cloud Function
  // (functions/src/recommendations.ts). The client can only read its own
  // and delete (dismiss) individual suggestions.
  match /users/{uid}/recommendations/{candidateId} {
    allow read: if isOwner(uid);
    allow delete: if isOwner(uid);
    allow create, update: if false;
  }

  // ---- Phase 2: Portfolio System ----

  match /projects/{projectId} {
    // Published projects are public (they're the point of a portfolio
    // product); drafts are only visible to their owner. Only the owner
    // can write, and `viewCount` is locked out of client writes — it's
    // bumped via a Cloud Function-safe increment call from
    // ProjectRepository.incrementViewCount, but since that still goes
    // through the client SDK (not Admin SDK), we allow *that one field*
    // to change via FieldValue.increment while everything else must stay
    // owner-only. Anyone signed in may bump the view counter (viewing
    // someone else's project shouldn't require write access to the rest
    // of the doc).
    allow read: if resource.data.status == 'published' || isOwner(resource.data.ownerId);

    allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;

    allow update: if (isOwner(resource.data.ownerId) && unchanged(['ownerId', 'viewCount']))
      || (isSignedIn() && unchanged([
           'ownerId', 'ownerUsername', 'ownerDisplayName', 'ownerPhotoURL', 'title',
           'projectDescription', 'tags', 'softwareUsed', 'year', 'collaboratorIds',
           'collaboratorNames', 'coverImageURL', 'mediaItems', 'status', 'searchKeywords',
           'createdAt', 'updatedAt'
         ]));

    allow delete: if isOwner(resource.data.ownerId);
  }

  // ---- Phase 3: Networking (NFC + Connections) ----

  // Doc ID is "{followerId}_{followingId}" — see Follow.documentId — so a
  // duplicate follow relationship is structurally impossible rather than
  // something rules have to police, and unfollow is just "delete the doc
  // whose ID you can already compute."
  match /follows/{followId} {
    allow read: if isSignedIn();
    allow create: if isSignedIn()
      && request.resource.data.followerId == request.auth.uid
      && followId == request.resource.data.followerId + '_' + request.resource.data.followingId;
    allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    allow update: if false;
  }

  // Doc ID is "{uidA}_{uidB}" sorted — see Connection.documentId — for the
  // same duplicate-prevention reason. `followerCount`/`followingCount` on
  // the user doc and `connectionCount` are never touched here; only the
  // onFollowCreated/onConnectionCreated/onConnectionUpdated Cloud
  // Functions increment them (Admin SDK, bypasses these rules), so a
  // client can't inflate its own numbers by spamming requests.
  match /connections/{connectionId} {
    // Accepted connections are readable by any signed-in user — this is
    // what lets the Phase 4 graph traverse "friends of friends" at all
    // (GraphViewModel reads other people's accepted connections to build
    // out depth-2/3). It's the same visibility model as a public
    // following list: who you're connected to is not secret, only
    // whether you have a *pending* request outstanding is, which is why
    // pending/declined stay restricted to the two participants.
    allow read: if isSignedIn()
      && (resource.data.status == 'accepted' || request.auth.uid in resource.data.participantIds);

    allow create: if isSignedIn()
      && request.auth.uid in request.resource.data.participantIds
      && request.resource.data.requestedBy == request.auth.uid
      && connectionId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
      // NFC connections are created already-accepted (physical proximity
      // is the consent signal); every other source must start pending —
      // you can't will your own connection request into being instantly
      // accepted by setting the field client-side.
      && (request.resource.data.status == 'pending' || request.resource.data.source == 'nfc_tag');

    // Only the *other* participant can accept/decline a pending request —
    // the requester can't accept their own request. Nothing else about
    // the document may change on a response.
    allow update: if isSignedIn()
      && request.auth.uid in resource.data.participantIds
      && request.auth.uid != resource.data.requestedBy
      && resource.data.status == 'pending'
      && request.resource.data.status in ['accepted', 'declined']
      && unchanged(['participantIds', 'participants', 'requestedBy', 'type', 'source', 'createdAt']);

    allow delete: if false;
  }

  // ---- Phase 5: Messaging ----

  // Doc ID is "{uidA}_{uidB}" sorted, same pattern as connections/follows.
  // Unlike connections, conversations are always private to their two
  // participants — there's no public-visibility case here.
  match /conversations/{conversationId} {
    allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;

    allow create: if isSignedIn()
      && request.auth.uid in request.resource.data.participantIds
      && conversationId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1];

    // Clients may only: flip their own unread count to 0, and add/remove
    // *their own* uid from typingUserIds. `lastMessageText`/
    // `lastMessageSenderId`/`lastMessageAt` change on every send too, but
    // that write happens as part of `sendTextMessage`/`sendVoiceMessage`
    // alongside creating the message doc — allowed here since it's the
    // same signed-in participant doing both in one client-side call.
    allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds
      && unchanged(['participantIds', 'participants', 'createdAt']);

    allow delete: if false;

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

      allow create: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.readBy == [request.auth.uid];

      // Only `readBy` may change, and only to append the reader's own uid
      // (enforced via MessageRepository always using arrayUnion — rules
      // can't easily distinguish "added self" from "added self plus
      // others" without a size diff check, so this at minimum blocks
      // editing message content after the fact).
      allow update: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        && unchanged(['senderId', 'type', 'text', 'voiceURL', 'voiceDurationSeconds', 'createdAt']);

      allow delete: if false;
    }
  }

  // ---- Phase 5: Community (Events) ----

  match /events/{eventId} {
    allow read: if true; // events are public/discoverable, like projects
    allow create: if isSignedIn()
      && request.resource.data.hostId == request.auth.uid
      && request.resource.data.attendeeIds == [request.auth.uid];
    // Every field except `attendeeIds` is locked to everyone but the host
    // via `unchanged`. `attendeeIds` itself isn't further restricted to
    // "only your own uid" here — that would need an array-diff-size check
    // this rule set doesn't otherwise use — so this trusts the client to
    // only ever arrayUnion/arrayRemove the signed-in user's own uid (which
    // is all EventRepository.toggleAttendance does). Low-stakes surface
    // (an RSVP list) rather than something worth the added rule
    // complexity to fully close.
    allow update: if isSignedIn() && unchanged([
      'title', 'eventDescription', 'coverImageURL', 'hostId', 'hostDisplayName', 'hostPhotoURL',
      'location', 'geohash', 'latitude', 'longitude', 'startsAt', 'endsAt', 'createdAt'
    ]);
    allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;
  }
}
