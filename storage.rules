rules_version = '2';

// Nodi Firebase Storage security rules.
//
// Layout convention: every uploaded object lives under
// `{category}/{ownerUid}/{filename}` so ownership can be checked purely
// from the path, without a Firestore read. Built up phase by phase like
// firestore.rules.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // ---- Phase 1: Auth + Profile Foundation ----

    match /profile_photos/{uid}/{fileName} {
      allow read: if true; // public profile asset
      allow write: if isOwner(uid) && isImage() && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    match /cover_images/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isImage() && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    // ---- Phase 2: Portfolio System ----

    match /project_media/images/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isImage() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    match /project_media/videos/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid)
        && request.resource.contentType.matches('video/.*')
        && request.resource.size < 500 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    match /project_media/documents/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid)
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    // ---- Phase 5: Messaging ----

    // Not public — a voice message is only meaningful in the context of a
    // specific conversation, so unlike profile/portfolio media, read
    // access is restricted to signed-in users (Storage rules can't reach
    // into Firestore to check conversation participancy without a
    // firestore.get() call, which Storage rules don't support the same
    // way Firestore rules do; the download URL itself is only ever handed
    // to conversation participants via ChatView, which is an acceptable
    // practical tradeoff for a launch-scale app).
    match /voice_messages/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid)
        && request.resource.contentType.matches('audio/.*')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }
  }
}
